{
  "name": "qurioso",
  "private": true,
  "version": "1.3.0",
  "author": "Maurizio Napolitano <maurizio.napolitano@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --publish never && node scripts/prepare-desktop-directory.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --publish never",
    "desktop:guide-screenshots": "npm run desktop:prepare && node scripts/capture-guide.mjs",
    "desktop:smoke": "node scripts/test-desktop.mjs",
    "desktop:internet-smoke": "node scripts/test-internet-sharing-live.mjs",
    "android:icons": "node scripts/prepare-android-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@zip.js/zip.js": "^2.24.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vimeo-video-element": "^1.7.4",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.22.0",
    "youtube-video-element": "^1.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "description": "Qurioso: classroom activities and local network quizzes",
  "main": "desktop/main.cjs"
}
